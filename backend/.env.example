# SpeechPal API configuration (copy to .env for local development; never commit .env)
PORT=4000
NODE_ENV=development
# Required only to enable opt-in speech-to-text from the mobile app.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Use a long random secret before any production deployment.
JWT_SECRET=
# Browser/admin origin(s), comma separated.
CORS_ORIGINS=http://localhost:3000
