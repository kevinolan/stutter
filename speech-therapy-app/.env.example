# FluentPath Coach configuration
#
# The app ships with a built-in, fully offline rule-based coach, so it works with
# NO configuration. To enable an LLM-backed coach, copy this file to `.env.local`
# and fill in your provider details. The client speaks the OpenAI
# Chat Completions shape, so any compatible endpoint works (OpenAI, OpenRouter,
# a local llama.cpp / Ollama server, etc.).
#
# IMPORTANT: never commit your real .env.local — it holds a secret key.

# Endpoint base, e.g. https://api.openai.com/v1 or https://openrouter.ai/api/v1
VITE_COACH_API_BASE=

# Provider API key. Optional — the app falls back to the local coach if empty.
VITE_COACH_API_KEY=

# Model id to request, e.g. gpt-4o-mini, openai/gpt-4o-mini, llama3.1:8b
VITE_COACH_MODEL=gpt-4o-mini
